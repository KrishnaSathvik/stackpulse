{
  "name": "stackpulse",
  "version": "3.4.0",
  "description": "Generate beautiful shareable cards for your AI coding tool usage — Claude Code, Codex, Cursor, Gemini CLI, Aider, and 8 more",
  "main": "index.js",
  "type": "module",
  "bin": {
    "stackpulse": "./bin/stackpulse.js"
  },
  "files": [
    "bin/",
    "index.js",
    "generator.js",
    "parsers/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets/card-dark.png",
    "assets/cli-dark.png",
    "website/public/logo-mark.png",
    "website/src/assets/tools/aider.png",
    "website/src/assets/tools/amp.svg",
    "website/src/assets/tools/antigravity.svg",
    "website/src/assets/tools/claude-code.svg",
    "website/src/assets/tools/codex.png",
    "website/src/assets/tools/cursor-dark.svg",
    "website/src/assets/tools/cursor.svg",
    "website/src/assets/tools/gemini-cli.png",
    "website/src/assets/tools/kilo-code.svg",
    "website/src/assets/tools/kimi.png",
    "website/src/assets/tools/opencode.svg",
    "website/src/assets/tools/pi.svg",
    "website/src/assets/tools/qwen-code.svg",
    "website/src/assets/tools/roo-code.png",
    "website/src/assets/tools/SOURCES.md",
    "website/src/assets/shots/theme-arctic.webp",
    "website/src/assets/shots/theme-cosmic.webp",
    "website/src/assets/shots/theme-dark.webp",
    "website/src/assets/shots/theme-forge.webp",
    "website/src/assets/shots/theme-light.webp",
    "website/src/assets/shots/theme-neon.webp",
    "website/src/assets/shots/theme-verdant.webp",
    "!src/collectors/sharded.js"
  ],
  "scripts": {
    "start": "node index.js",
    "prepublishOnly": "node --check index.js && node --check generator.js && npm test",
    "dev:website": "npm run dev --prefix website",
    "build:website": "npm run build --prefix website",
    "test": "node tests/run.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrishnaSathvik/stackpulse.git"
  },
  "homepage": "https://github.com/KrishnaSathvik/stackpulse#readme",
  "bugs": {
    "url": "https://github.com/KrishnaSathvik/stackpulse/issues"
  },
  "keywords": [
    "ai",
    "usage",
    "stats",
    "card",
    "shareable",
    "heatmap",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "aider",
    "amp",
    "opencode",
    "kimi",
    "antigravity",
    "roo-code",
    "kilo-code",
    "developer-tools",
    "cli",
    "productivity"
  ],
  "author": "Krishna Sathvik Mantripragada (https://github.com/KrishnaSathvik)",
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.0",
    "ccusage": "20.0.46",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "inquirer": "^13.3.0",
    "js-yaml": "^4.1.0",
    "ora": "^9.0.0"
  }
}
